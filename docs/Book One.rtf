\par \pard\plain \s0\ql\sl276\slmult1{\*\hyphen2\hyphlead2\hyphtrail2\hyphmax0}\aspalpha\ltrpar\nowidctlpar\cf0\kerning0\hich\af2\langfe2052\dbch\af2\afs24\lang1081\loch\f3\fs22\lang4105\sl100\slmult0{\cf1\hich\af8\dbch\af8\rtlch \ltrch\loch\fs24\loch\f6
