\par \pard\plain \s0\ql\sl276\slmult1{\*\hyphen2\hyphlead2\hyphtrail2\hyphmax0}\aspalpha\ltrpar\nowidctlpar\cf0\kerning0\hich\af2\langfe2052\dbch\af2\afs24\lang1081\loch\f3\fs22\lang4105\sl100\slmult0\li0\ri140\lin0\rin140\fi720{\cf1\hich\af8\dbch\af8\rtlch \ltrch\loch\fs24\loch\f6
Toni followed Marie as they adeptly made their way down the stairs.}
\par \pard\plain \s0\ql\sl276\slmult1{\*\hyphen2\hyphlead2\hyphtrail2\hyphmax0}\aspalpha\ltrpar\nowidctlpar\cf0\kerning0\hich\af2\langfe2052\dbch\af2\afs24\lang1081\loch\f3\fs22\lang4105\sl100\slmult0\li0\ri140\lin0\rin140\fi720{\cf1\rtlch \ltrch
\'93}{\cf1\hich\af8\dbch\af8\rtlch \ltrch\loch\fs24\loch\f6
