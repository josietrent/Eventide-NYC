\par \pard\plain \s0\ql\sl276\slmult1{\*\hyphen2\hyphlead2\hyphtrail2\hyphmax0}\aspalpha\ltrpar\nowidctlpar\cf0\kerning0\hich\af2\langfe2052\dbch\af2\afs24\lang1081\loch\f3\fs22\lang4105\sl100\slmult0\li0\ri140\lin0\rin140\fi720{\cf1\rtlch \ltrch
